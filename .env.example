# ==============================================================================
# Backend Fabrica Escuela - Variables de Entorno
# ==============================================================================
# Este archivo SI se versiona y no debe contener credenciales reales.
# Copia .env.example a .env y completa los valores de cada entorno.
# En Render estas mismas claves se cargan desde Environment > Environment Variables.
# ==============================================================================

# --- Base de datos (PostgreSQL) -----------------------------------------------
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_SSLMODE=require

# --- JPA / Hibernate ----------------------------------------------------------
# Valores validos: none, validate, update, create, create-drop
JPA_DDL_AUTO=update

# --- Backend JWT --------------------------------------------------------------
# Cadena en Base64 de minimo 32 bytes, requerida para la firma HS256.
# Generar con: openssl rand -base64 48
JWT_SECRET=your_base64_jwt_secret
JWT_EXPIRATION_MS=86400000

# --- Usuario administrador inicial (DataSeeder) -------------------------------
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=your_admin_password

# --- Servidor -----------------------------------------------------------------
# Render inyecta PORT automaticamente; en local se usa 8080 por defecto.
PORT=8080
